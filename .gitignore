# Dependencies
node_modules/
.tools/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Personal data (never commit these)
salary_data.json
profile/**
!profile/.gitkeep
/job_scraper/
*_BehavioralReport.pdf
linkedin_Profile.pdf

# Secrets. A portal skill generated by the add-portal skill may need an API token for a
# fetching service; the .env holding it must never be committed.
.env
.env.*

# Personal photos and signatures
*.jpg
*.jpeg
*.png
!cover_letters/OpenFonts/fonts/**

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Compatibility-client memory files
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json

# Personal application output files (generated by the apply skill — do not share)
# Extension-agnostic on the ignore side: a custom template registered by the
# add-template skill (e.g. Typst) writes main_<company>_<role>.typ instead of
# .tex, and it must be ignored just as reliably as the stock LaTeX output.
# The negations stay .tex-only - the stock example files are always LaTeX,
# and a wildcard negation (!cv/main_example.*) would also re-include build
# artifacts like main_example.pdf/.aux.
cv/main_*.*
!cv/main_example.tex
cv/*.txt
cover_letters/cover_*.*
cover_letters/Cover_*.*
!cover_letters/cover_example.tex

# documents/ contents are personal — only README and empty folder markers are tracked
documents/**
!documents/README.md
!documents/**/
!documents/**/.gitkeep

# Personal job search tracking
job_search_tracker.csv

# Gmail sync state (message IDs, subjects - personal data)
/gmail_sync/

# Generated reports (personal output from the html-report skill)
/reports/

# Upskill reports and working data (personal output)
/upskill/

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Locally assembled plugin packages
/dist/

# Brainstorm mockups (superpowers visual companion) - never ship
.superpowers/
